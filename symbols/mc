default partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1] = "Minecraft";

    // Key codes obtained from https://xkbedit.github.io/

    // NUMBERS ROW
    key <TLDE> { [ grave, asciitilde ] };
    key <AE01> { [ plus, exclam ] };
    key <AE02> { [ 2, at ] };
    key <AE03> { [ 8, numbersign ] };
    key <AE04> { [ k, dollar ] };
    key <AE05> { [ 0, parenright ] };
    key <AE06> { [ 6, asciicircum ] };
    key <AE07> { [ 7, ampersand ] };
    key <AE08> { [ 3, asterisk ] };
    key <AE09> { [ 9, parenleft ] };
    key <AE10> { [ 5, percent ] }; // 0
    key <AE11> { [ minus, underscore ] }; // -
    key <AE12> { [ equal, 1 ] }; // =

    // TOP LETTER ROW
    key <AD01> { [ q, Q ] }; // q
    key <AD02> { [ w, W ] }; // w
    key <AD03> { [ e, E ] }; // e
    key <AD04> { [ r, R ] }; // r
    key <AD05> { [ t, T ] }; // t
    key <AD06> { [ y, Y ] }; // y
    key <AD07> { [ u, U ] }; // u
    key <AD08> { [ c, I ] }; // i
    key <AD09> { [ f, O ] }; // o
    key <AD10> { [ p, P ] }; // p
    key <AD11> { [ bracketleft, braceleft ] }; // bracketleft [
    key <AD12> { [ bracketright, braceright ] }; // bracketright ]
    key <BKSL> { [ backslash, bar ] }; // backslash \

    // MIDDLE LETTER ROW
    key <AC01> { [ a, A ] }; // a
    key <AC02> { [ s, S ] }; // s
    key <AC03> { [ o, D ] }; // d
    key <AC04> { [ d, F ] }; // f
    key <AC05> { [ i, G ] }; // g
    key <AC06> { [ h, H ] }; // h
    key <AC07> { [ j, J ] }; // j
    key <AC08> { [ 4, K ] }; // k
    key <AC09> { [ l, L ] }; // l
    key <AC10> { [ semicolon, colon ] }; // semicolon ;
    key <AC11> { [ apostrophe, quotedbl ] }; // apostrophe '

    // BOTTOM LETTER ROW
    key <AB01> { [ z, Z ] }; // z
    key <AB02> { [ x, X ] }; // x
    key <AB03> { [ g, C ] }; // c
    key <AB04> { [ n, V ] }; // v
    key <AB05> { [ b, B ] }; // b
    key <AB06> { [ v, N ] }; // n
    key <AB07> { [ m, M ] }; // m
    key <AB08> { [ comma, less ] }; // comma ,
    key <AB09> { [ period, greater ] }; // period .
    key <AB10> { [ slash, question ] }; // slash /

    // SPACE
    key <SPCE> { [ space ] };
};